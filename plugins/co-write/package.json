{
  "name": "@hongxsen/dsh-co-write",
  "version": "0.1.0",
  "type": "module",
  "description": "人机双写：在对话或工作区文件里选中文字，就地评论；编号引用出现在输入框上方，并随下一条消息一起提交。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "co-write",
    "review",
    "annotation",
    "quote"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongxsen/dsh_plugins.git",
    "directory": "plugins/co-write"
  },
  "homepage": "https://github.com/hongxsen/dsh_plugins#readme"
}
