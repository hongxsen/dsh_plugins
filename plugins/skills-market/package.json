{
  "name": "@hongxsen/dsh-skills-market",
  "version": "0.3.2",
  "type": "module",
  "description": "Browse skills.sh, preview every file, and install community agent skills into ~/.dsh/skills from a full-page DSH sidebar panel.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "marketplace"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongxsen/dsh_plugins.git",
    "directory": "plugins/skills-market"
  },
  "homepage": "https://github.com/hongxsen/dsh_plugins#readme"
}
