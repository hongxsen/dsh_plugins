{
  "name": "@hongxsen/dsh-wallpaper",
  "version": "0.2.0",
  "type": "module",
  "description": "Paints one of several original wallpapers — or your own image — behind the DSH Web UI, and frosts the app surfaces so it shows through.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper",
    "theme",
    "background",
    "settings"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "art/*.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongxsen/dsh_plugins.git",
    "directory": "plugins/wallpaper"
  },
  "homepage": "https://github.com/hongxsen/dsh_plugins#readme"
}
